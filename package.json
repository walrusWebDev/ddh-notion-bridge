{
  "name": "ddh-notion-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP bridge service for Daily Dev Habit (PostgreSQL + Notion)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node src/mcp/server.ts",
    "build": "tsc",
    "start:mcp": "./entrypoint.sh",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
